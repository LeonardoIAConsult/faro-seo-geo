# Faro SEO·GEO — copiar a .env y rellenar. .env está en .gitignore (NUNCA subir).
#
# SOLO SECRETOS aquí (API keys, rutas de OAuth). La config NO-secreta del sitio
# (dominio, marca, queries GEO, umbrales, canal YouTube, exclusiones de archivos)
# vive en `faro.config.json`. Para auditar tu sitio: edita ese JSON + pon tus
# claves aquí. (SEO_SITE_DIR/URL pueden ir en .env o en el JSON.)

# --- Sitio a auditar (override del JSON; útil por máquina) ---
SEO_SITE_DIR=C:/ruta/a/tu/sitio-estatico
SEO_SITE_URL=https://www.example.com

# --- PageSpeed Insights (Core Web Vitals) ---
# API key gratis en https://developers.google.com/speed/docs/insights/v5/get-started
# Sin key funciona con límite bajo (~1 req cada pocos seg). Con key: 25.000/día.
PAGESPEED_API_KEY=

# --- Google Search Console (OAuth) ---
# credentials.json se descarga de Google Cloud Console (OAuth client "Desktop app").
# token.json lo genera el primer login. Ambos en .gitignore.
GSC_CREDENTIALS=credentials.json
GSC_TOKEN=token.json
GSC_SITE_URL=https://www.example.com/

# --- Google Analytics 4 (comportamiento real de visitantes) ---
# GRATIS (API oficial GA4 Data). Reusa credentials.json; habilita "Google Analytics Data API".
# GA4_PROPERTY_ID = id NUMÉRICO de la propiedad (GA -> Admin), NO el "G-XXXX" del tag.
# Sin esto, ga4_pull se salta (no rompe).
GA4_PROPERTY_ID=
GA4_TOKEN=ga4_token.json

# --- YouTube (auditoría del canal) ---
# Clave GRATIS de YouTube Data API v3 (misma consola de Google que PageSpeed/GSC).
# console.cloud.google.com -> Habilitar "YouTube Data API v3" -> Credenciales -> Clave de API.
YT_API_KEY=
YT_CHANNEL_ID=YOUR_CHANNEL_ID

# --- Google Business Profile (SEO local: perfil, reseñas, rendimiento) ---
# GRATIS (APIs oficiales) pero con GATE: además del OAuth (reusa credentials.json, scope
# business.manage), Google debe APROBAR el acceso a las Business Profile APIs (formulario) y
# hay que habilitarlas en el proyecto Cloud. Sin aprobación → 403 (gbp_pull avisa, no rompe).
# Descubre los IDs con: gbp_pull.py --report accounts. (No son secretos; pueden ir en config.)
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
GBP_TOKEN=gbp_token.json

# --- GEO multi-motor (opcional, DE PAGO) ---
# Gemini (citación GEO) es GRATIS con GOOGLE_GENERATIVE_AI_API_KEY (nivel usuario, la de gbrain).
# Para sumar más motores a geo_citation.py, agrega su key (sin key = ese motor se salta):
# OPENAI_API_KEY=            # ChatGPT con web_search (Responses API)
# PERPLEXITY_API_KEY=        # Perplexity sonar (citations nativas)

# --- Redes sociales (social_audit.py) — guía completa en directives/social_audit.md ---
# Instagram (Business/Creator + página FB): app en developers.facebook.com -> Instagram Graph API.
# IG_ACCESS_TOKEN=            # token largo (60 días) con instagram_basic + pages_show_list
# IG_USER_ID=                 # id de la cuenta IG business (o ponlo en config social.instagram_user_id)
# FB_PAGE_TOKEN=              # misma app, token de página
# LINKEDIN_TOKEN=             # requiere Marketing Developer Partner (dificultad alta)
# X_BEARER_TOKEN=             # X API v2 (de pago)

# --- IndexNow (indexación rápida en Bing/Yandex/etc.) — ACCIÓN PÚBLICA, OK del dueño ---
# Genera una clave (32+ hex), súbela a https://{host}/{clave}.txt, y ponla aquí.
# INDEXNOW_KEY=

# --- (Opcional futuro) API de datos de pago para backlinks/keyword-volume ---
# DataForSEO (pay-as-you-go): desbloquea volumen de keyword + backlinks de competencia.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
